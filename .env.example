# ==============================================================================
# PIP SaaS - Unified Single Master Environment Example (.env.example)
# ==============================================================================

# ── 1. Backend Database Connection ────────────────────────────────────────────
DATABASE_URL=sqlite:///./pip_saas.db
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/pip_saas_db

# ── 2. Backend Security & JWT Authentication ──────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=production
CORS_ORIGINS=*

# ── 3. Frontend API & WebSockets Configuration ────────────────────────────────
VITE_USER_SERVICE_URL=http://127.0.0.1:8001
VITE_ORGANIZATION_SERVICE_URL=http://127.0.0.1:8002
VITE_WS_URL=ws://127.0.0.1:8001/ws
